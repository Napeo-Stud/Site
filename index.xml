    <item>
      <title>Brillance</title>
      <link>https://napeo-stud.github.io/Site/portfolio/brillance/</link>
      <pubDate>Sat, 04 May 2024 18:10:37 +0200</pubDate>
      <guid>https://napeo-stud.github.io/Site/portfolio/brillance/</guid>
      <description>&lt;article class=&#34;title&#34;&gt;&lt;h1 id=&#34;brillance&#34;&gt;Bril­lance&lt;/h1&gt;&#xA;&lt;p&gt;Notez que je peux changer les couleur de thème de chacun de mes articles 👀&lt;/p&gt;&#xA;&lt;/article&gt;&#xA;&#xA;&lt;article class=&#34;dflt-win&#34;&gt;&#xA;&lt;figure&gt;&lt;img src=&#34;https://napeo-stud.github.io/Site/images/portfolio/Brillance-img_5.webp&#34;&gt;&#xA;&lt;/figure&gt;&#xA;&lt;/article&gt;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;  &#xD;&#xA;    &#xD;&#xA;  &#xD;&#xA;&#xD;&#xA;  &#xD;&#xA;&#xD;&#xA;  &#xD;&#xA;&#xD;&#xA;  &#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&lt;style&gt;&#xD;&#xA;&#xD;&#xA;  #hidder {&#xD;&#xA;    position: absolute;&#xD;&#xA;    height: calc(100% - 12rem);&#xD;&#xA;    width: calc(100%);&#xD;&#xA;    top: 4rem;&#xD;&#xA;    left: 0;&#xD;&#xA;    margin: 4.5rem 0;&#xD;&#xA;    overflow: hidden;&#xD;&#xA;  }&#xD;&#xA;  &#xD;&#xA;  #reco {&#xD;&#xA;    aspect-ratio: 5/4;&#xD;&#xA;    height: calc(100% - 1rem);&#xD;&#xA;    margin: 0 5rem 2rem 5rem;&#xD;&#xA;    padding: 0 4rem;&#xD;&#xA;    background-color: var(--secondary-color);&#xD;&#xA;    border-radius: 2rem;&#xD;&#xA;    position: relative;&#xD;&#xA;    overflow: hidden;&#xD;&#xA;  }&#xD;&#xA;  &#xD;&#xA;  @media (max-width: 815px) {&#xD;&#xA;    #hidder {&#xD;&#xA;      top: 0;&#xD;&#xA;      height: calc(100% - 6rem);&#xD;&#xA;    }&#xD;&#xA;  }&#xD;&#xA;&#xD;&#xA;  #reco h2 {&#xD;&#xA;    margin: 2rem 0;&#xD;&#xA;    max-width: unset;&#xD;&#xA;  }&#xD;&#xA;  #reco p {max-width: unset;}&#xD;&#xA;&#xD;&#xA;  #reco #pts-box {margin-top: .5rem;}&#xD;&#xA;  #reco #frm-pssr {&#xD;&#xA;    position: absolute;&#xD;&#xA;    left: unset;&#xD;&#xA;    right: 4rem;&#xD;&#xA;    bottom: 4rem;&#xD;&#xA;  }&#xD;&#xA;&#xD;&#xA;  .reco-lettres #autheur {&#xD;&#xA;    width: 100%;&#xD;&#xA;    text-align: right;&#xD;&#xA;    max-width: 64rem;&#xD;&#xA;    margin-bottom: 4rem;&#xD;&#xA;  }&#xD;&#xA;&#xD;&#xA;  .reco-lettres {&#xD;&#xA;    position: absolute;&#xD;&#xA;    height: 100%;&#xD;&#xA;    width: calc(100% - 8rem);&#xD;&#xA;    padding: 0 4rem;&#xD;&#xA;    display: flex;&#xD;&#xA;    flex-direction: column;&#xD;&#xA;    transition: transform .5s ease;&#xD;&#xA;    background-color: var(--secondary-color);&#xD;&#xA;    z-index: 1;&#xD;&#xA;  }&#xD;&#xA;&#xD;&#xA;  .reco-lettres h3 {&#xD;&#xA;    max-width: 64rem;&#xD;&#xA;    margin: 0 1.5rem 2rem 1.5rem;&#xD;&#xA;    font-size: 2rem;&#xD;&#xA;  }&#xD;&#xA;&#xD;&#xA;  .reco-lettres a {&#xD;&#xA;    display: block;&#xD;&#xA;    height: fit-content;&#xD;&#xA;    width: fit-content;&#xD;&#xA;    background-color: var(--accent-color);&#xD;&#xA;    border-radius: 1rem;&#xD;&#xA;    z-index: 2;&#xD;&#xA;    margin-left: 1rem;&#xD;&#xA;    transform: scale(1);&#xD;&#xA;    transition: transform .3s ease;&#xD;&#xA;  }&#xD;&#xA;  .reco-lettres a:hover {transform: scale(1.035)}&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;  .reco-lettres a p {&#xD;&#xA;    width: unset;&#xD;&#xA;    min-width: unset;&#xD;&#xA;    padding: .5rem;&#xD;&#xA;    margin-bottom: .6rem;&#xD;&#xA;    transition: font-weight .3s ease;&#xD;&#xA;  }&#xD;&#xA;  .reco-lettres a:hover p {font-weight: 700;}&#xD;&#xA;&#xD;&#xA;  #projets-title {margin-bottom: 1.5rem;}&#xD;&#xA;&#xD;&#xA;  @media (max-width: 815px) {&#xD;&#xA;    #reco {&#xD;&#xA;      width: calc(100% - 10rem);&#xD;&#xA;      margin: 0 2.5rem 3rem 2.5rem;&#xD;&#xA;      min-width: unset;&#xD;&#xA;      max-width: 26rem;&#xD;&#xA;      height: 37rem;&#xD;&#xA;      border-radius: 2rem;&#xD;&#xA;      padding: 0 2rem;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    #reco p {&#xD;&#xA;      font-size: 1.1rem;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    #reco h2 {&#xD;&#xA;      margin: 1rem 0 0 0;&#xD;&#xA;      font-size: 2.5rem;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    #reco h3 {&#xD;&#xA;      font-size: 1.2rem;&#xD;&#xA;      margin: 0 0 .5rem 1rem;&#xD;&#xA;      max-height: 20rem;&#xD;&#xA;      hyphens: auto;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    #reco #frm-pssr {&#xD;&#xA;      right: 1rem;&#xD;&#xA;      bottom: 1rem;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    .reco-lettres {&#xD;&#xA;      height: calc(100% - 2rem);&#xD;&#xA;      width: calc(100% - 4rem);&#xD;&#xA;      margin: 1rem 0;&#xD;&#xA;      padding: 0 2rem;&#xD;&#xA;    }&#xD;&#xA;    .reco-lettres #autheur {&#xD;&#xA;      min-width: unset;&#xD;&#xA;      margin-bottom: 1rem;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    #projets-title {margin-bottom: 1rem;}&#xD;&#xA;  }&#xD;&#xA;&#xD;&#xA;&lt;/style&gt;&#xD;&#xA;&#xD;&#xA;&lt;article id=&#34;reco&#34;&gt;&#xD;&#xA;  &lt;h2 class=&#34;fr&#34;&gt;Avis&lt;/h2&gt;&#xD;&#xA;  &lt;h2 class=&#34;en&#34;&gt;Review&lt;/h2&gt;&#xD;&#xA;  &lt;div id=&#34;hidder&#34; &gt;&#xD;&#xA;    &lt;div id=&#34;galleryA-container&#34; class=&#34;reco-lettres galleryA-indexed&#34; data-index=&#34;1&#34;&gt;&#xD;&#xA;      &lt;h3 class=&#34;fr&#34;&gt;J&amp;#39;ai eu le plaisir de collaborer avec Noé sur plusieurs projets web. Son professionnalisme et sa créativité sont remarquables.&lt;/h3&gt;&#xD;&#xA;      &lt;h3 class=&#34;en&#34;&gt;I had the pleasure of collaborating with Noé on several web projects. His professionalism and creativity are remarkable.&lt;/h3&gt;&#xD;&#xA;      &lt;p id=&#34;autheur&#34;&gt;Marie Dupont&lt;/p&gt;</description>
    </item>
